---
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { Picture } from 'astro:assets';

type Props = HTMLAttributes<'div'> & {
  image: ImageMetadata;
  alt: string;
  /** The `sizes` attribute: how wide the phone renders at each breakpoint. */
  sizes: string;
  /** Load eagerly with high priority. Use only for above-the-fold imagery. */
  priority?: boolean;
};

const { image, alt, sizes, priority = false, class: className, ...attrs } = Astro.props;

// Covers 1x to 3x displays for the sizes we render. Astro never upscales past the
// source width. (Reading properties of `image` here would make Astro ship the
// full-size original too, so the widths are fixed.)
const widths = [240, 360, 480, 640, 800];
---

<div class:list={['phone', className]} {...attrs}>
  <Picture
    src={image}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif']}
    fallbackFormat="webp"
    quality={70}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class="phone__screen"
  />
</div>

<style>
  /* A CSS-only device frame. Percent radii keep proportions at every size. */
  .phone {
    position: relative;
    aspect-ratio: 1080 / 2340;
    padding: 3.2%;
    border-radius: 15% / 7%;
    background: linear-gradient(145deg, #2b2226, #0b0809 40%, #1a1316);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      inset 0 0 0 4px #050304,
      var(--shadow-lg);
  }

  .phone::after {
    /* Punch-hole camera */
    content: '';
    position: absolute;
    top: 3.9%;
    left: 50%;
    width: 3.6%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #050304;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
    translate: -50% 0;
  }

  .phone :global(.phone__screen) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12% / 5.6%;
    background: #0a0a0a;
  }
</style>
