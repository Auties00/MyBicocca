---
import PhoneFrame from '~/components/ui/PhoneFrame.astro';
import type { TourChapter } from '~/data/tour';

interface Props {
  chapter: TourChapter;
  /** Mirror the layout so consecutive chapters alternate sides. */
  reversed?: boolean;
}

const { chapter, reversed = false } = Astro.props;
const { id, label, title, summary, icon: Icon, accent, screens } = chapter;

const tabId = (index: number) => `${id}-tab-${index}`;
const panelId = (index: number) => `${id}-panel-${index}`;
---

<article id={id} class:list={['chapter', { 'chapter--reversed': reversed }]} data-accent={accent} aria-labelledby={`${id}-title`}>
  <feature-tabs class="chapter__grid">
    <div class="chapter__copy reveal">
      <p class="eyebrow">
        <span class="chapter__icon"><Icon size={18} aria-hidden="true" /></span>
        {label}
      </p>
      <h3 id={`${id}-title`}>{title}</h3>
      <p class="chapter__summary">{summary}</p>

      <div class="tabs" role="tablist" aria-label={`${label} screens`} aria-orientation="vertical">
        {
          screens.map((screen, index) => (
            <button
              type="button"
              class="tab"
              role="tab"
              id={tabId(index)}
              aria-controls={panelId(index)}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-labelledby={`${tabId(index)}-title`}
              aria-describedby={`${tabId(index)}-description`}
              tabindex={index === 0 ? 0 : -1}
            >
              <span class="tab__title" id={`${tabId(index)}-title`}>
                {screen.title}
              </span>
              <span class="tab__description">
                <span id={`${tabId(index)}-description`}>{screen.description}</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="chapter__visual reveal">
      <div class="chapter__halo" aria-hidden="true"></div>
      {
        screens.map((screen, index) => (
          <div class="panel" role="tabpanel" id={panelId(index)} aria-labelledby={tabId(index)} hidden={index !== 0}>
            <PhoneFrame image={screen.image} alt={screen.alt} sizes="(min-width: 64rem) 19rem, (min-width: 40rem) 17rem, 62vw" />
          </div>
        ))
      }
    </div>
  </feature-tabs>
</article>

<script>
  import '~/scripts/feature-tabs';
</script>

<style>
  .chapter + .chapter {
    margin-top: clamp(5rem, 12vw, 9rem);
  }

  .chapter__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .chapter--reversed .chapter__copy {
    order: 2;
  }

  .chapter__copy {
    display: grid;
    gap: 1.1rem;
  }

  .chapter__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.6rem;
    background: color-mix(in oklab, var(--accent) 16%, transparent);
  }

  h3 {
    font-size: var(--step-3);
  }

  .chapter__summary {
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  /* ---- Tabs ---- */
  .tabs {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.75rem;
    border-left: 1px solid var(--line);
  }

  .tab {
    display: grid;
    position: relative;
    padding: 0.7rem 0 0.7rem 1.4rem;
    border: 0;
    background: none;
    text-align: left;
  }

  .tab::before {
    /* Active indicator riding the rail on the left. */
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: -1px;
    width: 3px;
    border-radius: 3px;
    background: var(--accent);
    scale: 1 0;
    transition: scale 0.35s var(--ease-out);
  }

  .tab__title {
    color: var(--text-subtle);
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 600;
    transition: color 0.2s;
  }

  .tab:hover .tab__title {
    color: var(--text-muted);
  }

  /* Descriptions expand smoothly for the selected tab. */
  .tab__description {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    color: var(--text-muted);
    line-height: 1.55;
    opacity: 0;
    transition:
      grid-template-rows 0.4s var(--ease-out),
      opacity 0.3s,
      margin 0.4s var(--ease-out);
  }

  .tab__description > span {
    min-height: 0;
  }

  .tab[aria-selected='true']::before {
    scale: 1;
  }

  .tab[aria-selected='true'] .tab__title {
    color: var(--text);
  }

  .tab[aria-selected='true'] .tab__description {
    grid-template-rows: 1fr;
    margin-top: 0.35rem;
    opacity: 1;
  }

  /* ---- Visual ---- */
  .chapter__visual {
    position: relative;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .chapter__halo {
    position: absolute;
    inset: 8% 0;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--accent) 28%, transparent), transparent);
    filter: blur(10px);
  }

  .panel {
    grid-area: 1 / 1;
    width: min(100%, 19rem);
    transition:
      opacity 0.45s var(--ease-out),
      scale 0.45s var(--ease-out),
      visibility 0.45s;
  }

  /*
   * Inactive panels keep their box (instead of display: none) so the crossfade can
   * run and their lazy images start loading as the chapter scrolls into view.
   * `visibility: hidden` still removes them from the accessibility tree.
   */
  .panel[hidden] {
    display: block;
    visibility: hidden;
    opacity: 0;
    scale: 0.96;
  }

  @media (prefers-reduced-motion: reduce) {
    .panel,
    .tab__description,
    .tab::before {
      transition: none;
    }
  }

  @media (max-width: 52rem) {
    .chapter__grid {
      grid-template-columns: 1fr;
    }

    /* Flatten the copy column so the phone can sit between the summary and the tabs. */
    .chapter__grid {
      gap: 1.1rem;
    }

    .chapter__copy {
      display: contents;
    }

    .chapter__visual {
      order: 1;
      margin-block: 1.5rem 0.5rem;
    }

    .tabs {
      order: 2;
    }

    .panel {
      width: min(58vw, 16rem);
    }
  }
</style>
