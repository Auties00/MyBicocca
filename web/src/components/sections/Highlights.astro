---
import { Picture } from 'astro:assets';
import { highlights } from '~/data/highlights';
---

<section id="features" class="section" aria-labelledby="features-title">
  <div class="container">
    <header class="section-heading">
      <p class="eyebrow">Features</p>
      <h2 id="features-title">Everything a student needs. Nothing they don't.</h2>
      <p>
        Native, fast and consistent: the small things that make the university's portals bearable, done properly.
      </p>
    </header>

    <ul class="bento" role="list">
      {
        highlights.map(({ title, description, icon: Icon, accent, media }) => (
          <li class:list={['card', 'reveal', { 'card--featured': media }]} data-accent={accent}>
            <span class="card__icon">
              <Icon size={22} aria-hidden="true" />
            </span>
            <h3>{title}</h3>
            <p>{description}</p>
            {media && (
              <div class="card__media">
                <Picture
                  src={media.image}
                  alt={media.alt}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 40vw, 80vw"
                  formats={['avif']}
                  fallbackFormat="webp"
                  quality={70}
                />
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    overflow: hidden;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(18rem 10rem at 0% 0%, color-mix(in oklab, var(--accent) 10%, transparent), transparent 70%),
      var(--surface);
    transition:
      border-color 0.3s,
      translate 0.4s var(--ease-out);
  }

  @media (hover: hover) {
    .card:hover {
      border-color: color-mix(in oklab, var(--accent) 40%, transparent);
      translate: 0 -3px;
    }
  }

  .card--featured {
    grid-column: span 2;
    grid-row: span 2;
    padding-bottom: 0;
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.5rem;
    border-radius: 0.85rem;
    background: color-mix(in oklab, var(--accent) 16%, transparent);
    color: var(--accent);
  }

  .card h3 {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }

  .card--featured h3 {
    font-size: var(--step-2);
  }

  .card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .card--featured p {
    max-width: 30rem;
    font-size: var(--step-0);
  }

  /* A screenshot peeking up from the bottom edge of the card. */
  .card__media {
    flex: 1;
    position: relative;
    min-height: 15rem;
    margin-top: 1.25rem;
  }

  .card__media :global(img) {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(70%, 20rem);
    height: auto;
    border: 1px solid var(--line-strong);
    border-bottom: 0;
    border-radius: 1.6rem 1.6rem 0 0;
    box-shadow: var(--shadow-lg);
    translate: -50% 0;
    /* Crop to the card: only the top of the screen shows. */
    max-height: 100%;
    object-fit: cover;
    object-position: top;
    aspect-ratio: auto;
  }

  @media (max-width: 64rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .bento {
      grid-template-columns: 1fr;
    }

    .card--featured {
      grid-column: auto;
      grid-row: auto;
    }

    .card__media {
      min-height: 18rem;
    }
  }
</style>
