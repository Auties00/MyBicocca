---
import Plus from '@lucide/astro/icons/plus';
import { faq } from '~/data/faq';
import { site } from '~/data/site';
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container faq">
    <header class="section-heading">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">Questions, answered.</h2>
      <p>
        Something else on your mind? <a href={site.links.issues} rel="noopener">Open an issue on GitHub</a> and we'll get
        back to you.
      </p>
    </header>

    <div class="faq__list">
      {
        faq.map(({ question, answer }, index) => (
          <details class="faq__item" name="faq" open={index === 0}>
            <summary>
              <h3>{question}</h3>
              <Plus size={20} aria-hidden="true" class="faq__toggle" />
            </summary>
            <p>{answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .faq .section-heading {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .faq .section-heading a {
    color: var(--brand-300);
  }

  .faq__list {
    border-top: 1px solid var(--line);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
    interpolate-size: allow-keywords;
  }

  .faq__item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.4s var(--ease-out),
      content-visibility 0.4s allow-discrete;
  }

  .faq__item[open]::details-content {
    block-size: auto;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.35rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    font-family: var(--font-body);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .faq__item :global(.faq__toggle) {
    flex-shrink: 0;
    color: var(--text-subtle);
    transition:
      rotate 0.3s var(--ease-out),
      color 0.2s;
  }

  .faq__item[open] :global(.faq__toggle) {
    rotate: 45deg;
    color: var(--brand-300);
  }

  .faq__item p {
    max-width: 40rem;
    padding-bottom: 1.5rem;
    color: var(--text-muted);
  }

  @media (max-width: 52rem) {
    .faq {
      grid-template-columns: 1fr;
    }

    .faq .section-heading {
      position: static;
      margin-bottom: 0;
    }
  }
</style>
