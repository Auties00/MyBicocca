---
import { tour } from '~/data/tour';
import TourChapter from './TourChapter.astro';
---

<section id="tour" class="section tour" aria-labelledby="tour-title">
  <div class="container">
    <header class="section-heading section-heading--center">
      <p class="eyebrow">Take the tour</p>
      <h2 id="tour-title">Four tabs. Your whole university.</h2>
      <p>Every screen below is the real app, running against the real university services.</p>
      <nav class="tour__nav" aria-label="Tour chapters">
        <ul role="list">
          {
            tour.map(({ id, label, icon: Icon, accent }) => (
              <li data-accent={accent}>
                <a href={`#${id}`}>
                  <Icon size={16} aria-hidden="true" />
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    {tour.map((chapter, index) => <TourChapter chapter={chapter} reversed={index % 2 === 1} />)}
  </div>
</section>

<style>
  .tour {
    position: relative;
    background: linear-gradient(to bottom, transparent, var(--brand-950) 18%, var(--brand-950) 82%, transparent);
  }

  .tour__nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .tour__nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text-muted);
    font-size: 0.925rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .tour__nav a:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
    color: var(--text);
  }

  .tour__nav :global(svg) {
    color: var(--accent);
  }
</style>
