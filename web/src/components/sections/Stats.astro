---
import { stats } from '~/data/stats';
---

<section class="stats" aria-label="MyBicocca in numbers">
  <dl class="container stats__grid">
    {
      stats.map(({ value, label }) => (
        <div class="stat reveal">
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .stats {
    padding-block: clamp(2rem, 5vw, 3rem);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--line);
    gap: 1px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--surface);
  }

  /* The value leads visually; the label stays first in the source for <dl> semantics. */
  dd {
    order: -1;
    font-family: var(--font-heading);
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    background: linear-gradient(180deg, var(--text), var(--brand-200));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  dt {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 52rem) {
    .stats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
