---
import type { Moment } from '~/data/day';

interface Props {
  moment: Moment;
}

const { moment } = Astro.props;

/** Splits a search hit around the first case-insensitive match of the query. */
function highlight(title: string, query: string): readonly [string, string, string] {
  const start = title.toLowerCase().indexOf(query.toLowerCase());
  if (start < 0) return [title, '', ''];
  const end = start + query.length;
  return [title.slice(0, start), title.slice(start, end), title.slice(end)];
}
---

<div class:list={['moment', `moment--${moment.kind}`, moment.kind === 'event' && `tint-${moment.tint}`]}>
  {
    moment.kind === 'event' && (
      <>
        <p class="event__range">{moment.range}</p>
        <p class="event__title">{moment.title}</p>
        <p class="event__type">{moment.type}</p>
        <p class="event__place">{moment.place}</p>
      </>
    )
  }

  {
    moment.kind === 'exam-call' && (
      <>
        <p class="call__course">{moment.course}</p>
        <p class="call__code">{moment.code}</p>
        <ul class="call__dates" role="list">
          {moment.dates.map(({ day, month, mode }) => (
            <li>
              <span class="call__day">{day}</span>
              <span class="call__month">{month}</span>
              <span class="call__mode">{mode}</span>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    moment.kind === 'result' && (
      <>
        <p class="result__grade" aria-label={`Grade ${moment.grade} out of 30`}>
          {moment.grade}
        </p>
        <div>
          <p class="result__course">{moment.course}</p>
          <p class="result__note">{moment.note}</p>
        </div>
      </>
    )
  }

  {
    moment.kind === 'building' && (
      <>
        <p class="building__code">{moment.code}</p>
        <div>
          <p class="building__name">{moment.name}</p>
          <p class="building__address">{moment.address}</p>
        </div>
        <p class="building__rooms">{moment.rooms} aule</p>
      </>
    )
  }

  {
    moment.kind === 'search' && (
      <>
        <p class="search__field">
          <span class="visually-hidden">Search: </span>
          {moment.query}
          <span class="search__caret" aria-hidden="true" />
        </p>
        <ul class="search__hits" role="list">
          {moment.hits.map(({ title, section }) => {
            const [before, match, after] = highlight(title, moment.query);
            return (
              <li>
                <span class="search__title">
                  {before}
                  <mark>{match}</mark>
                  {after}
                </span>
                <span class="search__section">{section}</span>
              </li>
            );
          })}
        </ul>
      </>
    )
  }
</div>

<style>
  /*
   * Each fragment mirrors a component of the app. Colours blend from the app's light
   * palette to its dark one as the page's day turns to night (`--night`, 0 → 1).
   */
  .moment {
    --mix: calc(var(--night) * 100%);
    --surface: color-mix(in oklab, #1a0d10 var(--mix), #f6eeef);
    --on-surface: color-mix(in oklab, #f3e7e9 var(--mix), #211a1b);
    --on-surface-soft: color-mix(in oklab, #b89398 var(--mix), #5c4b4e);
    --primary: #d81648;

    width: min(100%, 25rem);
    border-radius: 0.85rem;
    color: var(--on-surface);
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  /* ---- Calendar event block: tinted container, accent bar, caps title ---- */
  .moment--event {
    --container: color-mix(in oklab, var(--container-dark) var(--mix), var(--container-light));
    --accent: color-mix(in oklab, var(--accent-dark) var(--mix), var(--accent-light));
    --on-container: color-mix(in oklab, var(--on-dark) var(--mix), var(--on-light));

    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1.1rem 1rem 1.25rem;
    border-left: 4px solid var(--accent);
    border-radius: 0.6rem 0.85rem 0.85rem 0.6rem;
    background: var(--container);
    color: var(--on-container);
  }

  .tint-amber {
    --accent-light: #d97706; --container-light: #fde68a; --on-light: #92400e;
    --accent-dark: #fbbf24; --container-dark: #3f1d08; --on-dark: #fde68a;
  }

  .tint-violet {
    --accent-light: #7c3aed; --container-light: #ddd6fe; --on-light: #5b21b6;
    --accent-dark: #a78bfa; --container-dark: #2e1065; --on-dark: #ddd6fe;
  }

  .tint-teal {
    --accent-light: #0d9488; --container-light: #99f6e4; --on-light: #115e59;
    --accent-dark: #2dd4bf; --container-dark: #082f2e; --on-dark: #99f6e4;
  }

  .tint-exam {
    --accent-light: #dc2626; --container-light: #fecaca; --on-light: #991b1b;
    --accent-dark: #f87171; --container-dark: #450a0a; --on-dark: #fecaca;
  }

  .tint-deadline {
    --accent-light: #b45309; --container-light: #fef3c7; --on-light: #78350f;
    --accent-dark: #fbbf24; --container-dark: #451a03; --on-dark: #fde68a;
  }

  .event__range,
  .event__place {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .event__title {
    margin-top: 0.15rem;
    font-size: 1.05rem;
    font-weight: 750;
    font-stretch: 92%;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .event__type {
    opacity: 0.8;
  }

  .event__place {
    margin-top: 0.6rem;
  }

  /* ---- Exam call: course header and date chips ---- */
  .moment--exam-call {
    padding: 1rem 1.1rem 1.1rem;
    background: var(--surface);
  }

  .call__course {
    font-weight: 750;
    font-stretch: 92%;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .call__code {
    color: var(--on-surface-soft);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .call__dates {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .call__dates li {
    display: grid;
    justify-items: center;
    padding: 0.55rem 0.25rem 0.45rem;
    border-radius: 0.7rem;
    background: color-mix(in oklab, #7a1530 var(--mix), #ffd9df);
    color: color-mix(in oklab, #ffd9df var(--mix), #400014);
  }

  .call__dates li:first-child {
    background: var(--primary);
    color: #fff;
  }

  .call__day {
    font-size: 1.5rem;
    font-weight: 700;
    font-stretch: 80%;
    line-height: 1;
  }

  .call__month,
  .call__mode {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .call__mode {
    margin-top: 0.2rem;
    opacity: 0.75;
  }

  /* ---- Exam result: grade badge and course ---- */
  .moment--result {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    background: var(--surface);
  }

  .result__grade {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    font-size: 1.45rem;
    font-weight: 800;
    font-stretch: 80%;
  }

  .result__course {
    font-weight: 750;
    font-stretch: 92%;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .result__note {
    color: var(--on-surface-soft);
  }

  /* ---- Building row from the map's directory ---- */
  .moment--building {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1.1rem;
    background: var(--surface);
  }

  .building__code {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: color-mix(in oklab, #7a1530 var(--mix), #ffd9df);
    color: color-mix(in oklab, #ffd9df var(--mix), #400014);
    font-weight: 750;
  }

  .building__name {
    font-weight: 750;
    font-stretch: 92%;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .building__address,
  .building__rooms {
    color: var(--on-surface-soft);
  }

  .building__rooms {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  /* ---- Search field and results ---- */
  .moment--search {
    overflow: hidden;
    background: var(--surface);
  }

  .search__field {
    display: flex;
    align-items: center;
    padding: 0.95rem 1.1rem;
    border-bottom: 1px solid color-mix(in oklab, var(--on-surface) 12%, transparent);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .search__caret {
    width: 2px;
    height: 1.2em;
    margin-left: 1px;
    background: var(--primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .search__caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .search__hits li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1.1rem;
  }

  .search__hits li + li {
    border-top: 1px solid color-mix(in oklab, var(--on-surface) 8%, transparent);
  }

  .search__title {
    font-weight: 600;
  }

  .search__title mark {
    background: none;
    color: var(--primary);
  }

  .search__section {
    color: var(--on-surface-soft);
    font-size: var(--text-xs);
    text-align: right;
  }
</style>
