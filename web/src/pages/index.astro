---
import Chapter from '~/components/Chapter.astro';
import Hero from '~/components/Hero.astro';
import Masthead from '~/components/Masthead.astro';
import Night from '~/components/Night.astro';
import NowLine from '~/components/NowLine.astro';
import Footer from '~/components/Footer.astro';
import Tomorrow from '~/components/Tomorrow.astro';
import { day } from '~/data/day';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout>
  <NowLine />
  <Masthead />
  <main id="main">
    <Hero />
    {day.map((chapter) => <Chapter chapter={chapter} />)}
    <Night />
    <Tomorrow />
  </main>
  <Footer />
</BaseLayout>
