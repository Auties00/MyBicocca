{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mybicocca-landing",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"routes": [
		{ "pattern": "mybicocca.it", "custom_domain": true }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/it", "/it/", "/en", "/en/"]
	}
}
