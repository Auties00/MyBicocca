{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"services_subtitle": "Teaching, bookings, documents and fees, all in one place.",
	"services_nav_label": "All services",
	"services_group_teaching_caption": "Programme, attendance and results",
	"services_group_bookings_caption": "Exams, offices and study seats",
	"services_group_documents_caption": "Enrolments, degrees and certificates",
	"services_group_fees_caption": "Your administrative standing",
	"services_summary_sync_failed": "Sync failed",
	"services_summary_none": "No upcoming deadlines",
	"services_summary_next": [
		{
			"declarations": ["input date", "input day"],
			"selectors": ["day"],
			"match": {
				"day=*": "Next on {date}"
			}
		}
	],
	"services_summary_overdue_on": [
		{
			"declarations": ["input date", "input day"],
			"selectors": ["day"],
			"match": {
				"day=*": "Overdue since {date}"
			}
		}
	],
	"services_summary_urgent": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{count} urgent",
				"countPlural=other": "{count} urgent"
			}
		}
	],
	"services_badge_results": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{count} to decide",
				"countPlural=other": "{count} to decide"
			}
		}
	],
	"services_badge_fees_overdue": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{count} overdue",
				"countPlural=other": "{count} overdue"
			}
		}
	],
	"services_badge_fees_due": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{count} to pay",
				"countPlural=other": "{count} to pay"
			}
		}
	],
	"services_badge_exams_booked": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{count} booked",
				"countPlural=other": "{count} booked"
			}
		}
	],
