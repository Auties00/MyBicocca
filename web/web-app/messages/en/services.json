		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{count} deadline in the next 30 days",
				"countPlural=other": "{count} deadlines in the next 30 days"
