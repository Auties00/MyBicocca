		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "All settled · 1 invoice",
				"countPlural=other": "All settled · {count} invoices"
			}
		}
	],
