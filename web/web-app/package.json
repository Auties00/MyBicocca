{
	"name": "mybicocca-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"data-api",
		"relay"
	],
	"scripts": {
		"dev": "vite dev",
		"dev:demo": "vite dev --mode demo",
		"build": "vite build",
		"build:demo": "vite build --mode demo",
		"preview": "vite preview",
		"prepare": "npm run i18n && svelte-kit sync || echo ''",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy custom-language preferredLanguage baseLocale --output-structure locale-modules --emit-ts-declarations --silent",
		"licences": "node scripts/licences.ts",
		"check": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"screens": "node tools/screenshots/capture-screenshots.ts",
		"typecheck": "tsc -p data-api && tsc -p data-api/test && tsc -p relay",
		"test:live": "npm run test:live -w data-api"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@mybicocca/data-api": "*",
		"@mybicocca/relay": "*",
		"hls.js": "^1.7.3",
		"maplibre-gl": "^6.16.0",
		"pdfjs-dist": "^6.4.299"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@iconify-json/ph": "^1.2.2",
		"@inlang/paraglide-js": "^2.29.2",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"linkedom": "0.18.12",
		"pmtiles": "^4.5.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"puppeteer-core": "^25.16.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.155.0"
	}
}
