{
  "readers": [
    {
      "type": "esse3"
    },
    {
      "type": "openapi",
      "options": {
        "spec": "web/certificates.yaml"
      }
    },
    {
      "type": "openapi",
      "options": {
        "spec": "client.yaml"
      }
    },
    {
      "type": "openapi",
      "options": {
        "spec": "ratings.yaml"
      }
    }
  ],
  "targets": {
    "kotlin": {
      "outputDir": "../../../android/data-api/src/main/kotlin",
      "testOutputDir": "../../../android/data-api/src/test/kotlin",
      "resourceOutputDir": "../../../android/data-api/src/main/resources",
      "options": {
        "packageName": "it.attendance100.mybicocca.data.remote.esse3",
        "temporalSerializers": [
          {
            "kind": "LOCAL_DATE",
            "pattern": "dd/MM/yyyy",
            "blankAsNull": true,
            "nullable": true,
            "serializer": "Esse3NullableLocalDateSerializer"
          },
          {
            "kind": "LOCAL_DATE_TIME",
            "pattern": "dd/MM/yyyy HH:mm:ss",
            "blankAsNull": true,
            "nullable": true,
            "serializer": "Esse3NullableLocalDateTimeSerializer"
          }
        ]
      }
    },
    "swift": {
      "outputDir": "../../../ios/DataApi/Sources",
      "testOutputDir": "../../../ios/DataApi/Tests/LiveTests",
      "options": {
        "module": "Esse3"
      }
    },
    "web": {
      "outputDir": "../../../web/data-api/src",
      "testOutputDir": "../../../web/data-api/test",
      "options": {
        "packageName": "esse3"
      }
    }
  }
}
