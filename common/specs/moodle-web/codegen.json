  "reader": {
    "type": "openapi",
    "options": {
      "spec": "pages.yaml"
    }
  },
  "targets": {
    "kotlin": {
      "outputDir": "../../../android/data-api/src/main/kotlin",
      "testOutputDir": "../../../android/data-api/src/test/kotlin",
      "resourceOutputDir": "../../../android/data-api/src/main/resources",
      "options": {
        "packageName": "it.attendance100.mybicocca.data.remote.elearning"
      }
    },
    "swift": {
      "outputDir": "../../../ios/DataApi/Sources",
      "testOutputDir": "../../../ios/DataApi/Tests/LiveTests",
      "options": {
        "module": "Elearning"
      }
    },
    "web": {
      "outputDir": "../../../web/web-app/data-api/src",
      "testOutputDir": "../../../web/web-app/data-api/test",
      "options": {
        "packageName": "elearning"
      }
    }
  }
}
