<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- pagoPA avviso/quietanza PDFs are written to cacheDir/taxes and shared via FileProvider. -->
    <cache-path name="tax_docs" path="taxes/" />
    <!-- Downloaded elearning course files; shared when the user opens one in an external app. -->
    <cache-path name="elearning_files" path="elearning_files/" />
    <!-- Downloaded certificate PDFs, cached per-certificate so they open without re-downloading. -->
    <cache-path name="certificati" path="certificati/" />
    <!-- Downloaded APKs for in-app updates. -->
    <cache-path
            name="updates"
            path="updates/" />
    <!-- Crash logs assembled by CrashLogBuilder, shared from the crash screen. -->
    <cache-path
            name="crash_logs"
            path="crash_logs/" />
</paths>
