<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="Theme.MyBicocca" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">@color/launcher_background</item>
    <item name="android:statusBarColor">@color/launcher_background</item>
    <item name="android:windowLightStatusBar">false</item>
  </style>

  <!-- AppCompat theme for OSS Licenses activity -->
  <style name="Theme.MyBicocca.AppCompat" parent="Theme.AppCompat.DayNight.DarkActionBar">
    <item name="android:windowBackground">@color/launcher_background</item>
    <item name="android:statusBarColor">@color/launcher_background</item>
    <item name="color">@color/primary</item>
    <item name="colorAccent">@color/primary</item>
    <item name="colorPrimary">@color/primary</item>
    <item name="colorPrimaryDark">@color/primary</item>
    <item name="android:colorBackground">@color/launcher_background</item>
    <item name="android:color">@color/launcher_background</item>
    <item name="android:fitsSystemWindows">true</item>
  </style>
</resources>